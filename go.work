// The workspace over docinfer's Go modules, kept in sync with the root mise.toml's GO_MODULES: the
// base module and the postgres module, which requires it, then the cmd/docinfer module as the task
// that builds it lands, so a change to the base is seen by them before it is tagged. The check
// runs every module with GOWORK=off, as a consumer resolves it.
go 1.27.4

use (
	.
	./postgres
)
